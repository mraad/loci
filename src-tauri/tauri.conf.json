{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loci",
  "version": "0.2.0",
  "identifier": "app.loci.desktop",
  "build": {"frontendDist": "../.build/web", "beforeBuildCommand": "node scripts/prepare-web.js", "beforeDevCommand": "node scripts/prepare-web.js"},
  "app": {"withGlobalTauri": true,"windows": [{"label":"main","title":"Loci","width":1440,"height":960,"minWidth":640,"minHeight":540}],"security":{"csp":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"}},
  "bundle": {"active":true,"targets":"all","icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],"macOS":{"infoPlist":"Info.plist","entitlements":"Entitlements.plist"}}
